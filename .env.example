FLASK_ENV=development
SECRET_KEY=change-me
# SQLite default (if omitted): <project_root>/instance/tadamun.db (absolute path in app config)
# DATABASE_URL=sqlite:///custom/path/my.db
SESSION_TIMEOUT_MINUTES=30
REAL_SCAN_ENABLED=true
SCAN_ALLOWED_CIDRS=192.168.1.0/24
SCAN_DEFAULT_PROFILE=-Pn --open --top-ports 200
NMAP_BINARY_PATH=/opt/homebrew/bin/nmap
SCAN_TIMEOUT_SEC=300
SCAN_MAX_TARGETS=16
SCAN_FALLBACK_PROFILE=-sn
AUTO_SCAN_ON_START=true
AUTO_SCAN_INTERVAL_SEC=120
